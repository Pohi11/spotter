# The public demo host's settings. init-env.sh writes vps.env on the host with random
# secrets; vps.env is never committed and never leaves the host.

# deploy/demo's secrets
POSTGRES_PASSWORD=change-me-to-a-long-random-string
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-to-a-long-random-string

# The hostname Caddy obtains a certificate for, e.g. 203-0-113-7.sslip.io or a real domain
SITE_ADDRESS=203-0-113-7.sslip.io

# The shared login. The hash is bcrypt from `caddy hash-password`; single quotes keep
# Compose from reading its $ signs as variables.
BASIC_AUTH_USER=spotter
BASIC_AUTH_HASH='$2a$14$replace.with.output.of.caddy.hash-password'
